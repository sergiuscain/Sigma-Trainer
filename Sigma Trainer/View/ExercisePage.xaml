<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:viewmodel="clr-namespace:Sigma_Trainer.ViewModel"
             xmlns:entities="clr-namespace:DBLibrary.Entities;assembly=DBLibrary"
             xmlns:res="clr-namespace:Sigma_Trainer.Resources.Languages"
             x:DataType="viewmodel:ExerciseViewModel"
             x:Class="Sigma_Trainer.View.ExercisePage"
             Title="{Binding Name}"
             BackgroundColor="{DynamicResource PrimaryColor}">
    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="TextColor" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>

        <Style TargetType="Frame">
            <Setter Property="Padding" Value="15"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HasShadow" Value="True"/>
            <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryColor}"/>
            <Setter Property="BorderColor" Value="{DynamicResource SecondaryColor}"/>
        </Style>

        <Style TargetType="Grid">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryColor}"/>
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="0" 
                        Text="{x:Static res:Strings.Add_a_score}" 
                        Command="{Binding AddScoreCommand}"/>
                <Button Grid.Column="1" 
                        Text="✏️" 
                        Command="{Binding RenameExerciseCommand}"/>
                <Button Grid.Column="2" 
                        Text="X" 
                        Command="{Binding DeleteExerciseCommand}"
                        BackgroundColor="Red"/>
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*">
                <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Text="{x:Static res:Strings.Previous}" Command="{Binding GetPreviousStatisticsPageCommand}"/>
                <Button Grid.Column="0" Grid.Row="0" Text="7" Command="{Binding EditStatisticsPageSizerCommand}" CommandParameter="7"/>
                <Button Grid.Column="1" Grid.Row="0" Text="30" Command="{Binding EditStatisticsPageSizerCommand}" CommandParameter="30"/>
                <Button Grid.Column="2" Grid.Row="0" Text="90" Command="{Binding EditStatisticsPageSizerCommand}" CommandParameter="90"/>
                <Button Grid.Column="3" Grid.Row="0" Text="180" Command="{Binding EditStatisticsPageSizerCommand}" CommandParameter="180"/>
                <Button Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Text="{x:Static res:Strings.Next}" Command="{Binding GetNextStatisticsPageCommand}"/>
            </Grid>
            <Frame>
                <lvc:CartesianChart Series="{Binding Series}" 
                            XAxes="{Binding XAxes}" 
                            YAxes="{Binding YAxes}"
                            HeightRequest="300" 
                            VerticalOptions="Start"
                            BackgroundColor="Transparent"/>
            </Frame>

            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*,*" Padding="10">

                <!-- Заголовки столбцов -->
                <Label Text="Все время" Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" FontAttributes="Bold"/>
                <Label Text="За период" Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" FontAttributes="Bold"/>
                <!-- Значения статистики -->
                <Label Text="{Binding AllTimeStatistics}" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center"/>
                <Label Text="{Binding StatisticsForPeriod}" Grid.Row="1" Grid.Column="1" HorizontalOptions="Center"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>